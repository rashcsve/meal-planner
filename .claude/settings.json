{
  "permissions": {
    "ask": [
      "Bash(npx drizzle-kit migrate*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(*psql*)",
      "Bash(docker exec*)"
    ],
    "deny": ["Bash(*DROP*)", "Bash(*TRUNCATE*)", "Read(.env)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/prettier-format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
