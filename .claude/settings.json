{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(echo \"EXIT=$?\")",
      "Bash(npx prettier *)"
    ],
    "deny": [
      "Bash(*DROP*)",
      "Bash(*TRUNCATE*)",
      "Read(.env)"
    ],
    "ask": [
      "Bash(npx drizzle-kit migrate*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(*psql*)",
      "Bash(docker exec*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/prettier-format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
